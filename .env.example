# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_API_BASE_URL: Base URL for the Tanal backend API.
#
# Optional. Resolved in lib/api-config.ts, which defaults to the value below, so
# the app runs without a .env.local. Set it to point at another backend (staging,
# a local Laravel via e.g. http://localhost:8000/api/v1).
#
# Must be an ABSOLUTE url INCLUDING the /api/v1 suffix; a trailing slash is fine.
# A malformed value fails the build with an explicit message rather than silently
# falling back. next.config.ts reads the same value to derive the CSP
# connect-src/img-src and images.remotePatterns, so this one variable is all you
# need to change.
NEXT_PUBLIC_API_BASE_URL="https://portal.tanalevents.com/api/v1"
